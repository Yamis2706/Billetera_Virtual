<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="10" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml">
    <HBox spacing="10">
        <Label text="Cuenta Origen:"/>
        <ComboBox fx:id="cbCuentaOrigen"/>
        <Label text="Cuenta Destino:"/>
        <ComboBox fx:id="cbCuentaDestino"/>
    </HBox>
    <HBox spacing="10">
        <Label text="Tipo de Transacción:"/>
        <ComboBox fx:id="cbTipoTransaccion"/>
        <Label text="Monto:"/>
        <TextField fx:id="txtMonto"/>
        <Button text="Realizar Transacción" onAction="#realizarTransaccion"/>
    </HBox>
    <TableView fx:id="tablaTransacciones">
        <columns>
            <TableColumn text="ID" fx:id="colId"/>
            <TableColumn text="Tipo" fx:id="colTipo"/>
            <TableColumn text="Cuenta Origen" fx:id="colOrigen"/>
            <TableColumn text="Cuenta Destino" fx:id="colDestino"/>
            <TableColumn text="Monto" fx:id="colMonto"/>
            <TableColumn text="Fecha" fx:id="colFecha"/>
        </columns>
    </TableView>
    <Label fx:id="lblMensaje"/>
</VBox>