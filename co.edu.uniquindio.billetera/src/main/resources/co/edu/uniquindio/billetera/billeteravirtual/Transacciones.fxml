<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="co.edu.uniquindio.billetera.billeteravirtual.controller.TransaccionController" prefWidth="900" prefHeight="600">
    <children>
        <VBox spacing="15" alignment="TOP_CENTER" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
            <children>
                <Label text="Gestión de Transacciones" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120"/>
                        <ColumnConstraints minWidth="220"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="30"/>
                        <RowConstraints minHeight="30"/>
                        <RowConstraints minHeight="30"/>
                        <RowConstraints minHeight="30"/>
                        <RowConstraints minHeight="30"/>
                        <RowConstraints minHeight="30"/>
                    </rowConstraints>
                    <children>

                        <Label text="Tipo:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="cbTipoTransaccion" promptText="Depósito/Retiro/Transferencia" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Cuenta Origen:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="cbCuentaOrigen" promptText="Seleccione cuenta" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Cuenta Destino:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="cbCuentaDestino" promptText="Seleccione cuenta destino" GridPane.rowIndex="1" GridPane.columnIndex="1"/>


                        <Label text="Categoría:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="cbCategoria" promptText="Seleccione categoría" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <Label text="Monto:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtMonto" promptText="Monto" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                        <Label text="Descripción:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtDescripcion" promptText="Descripción" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                    </children>
                </GridPane>
                <HBox spacing="10" alignment="CENTER">
                    <Button text="Agregar" onAction="#realizarTransaccion"/>
                    <Button text="Eliminar" onAction="#eliminarTransaccion"/>
                </HBox>
                <Label fx:id="lblMensaje" style="-fx-text-fill: red;"/>
                <TableView fx:id="tablaTransacciones" prefHeight="350">
                    <columns>
                        <TableColumn fx:id="colId" text="ID"/>
                        <TableColumn fx:id="colFecha" text="Fecha"/>
                        <TableColumn fx:id="colOrigen" text="Cuenta Origen"/>
                        <TableColumn fx:id="colDestino" text="Cuenta Destino"/>
                        <TableColumn fx:id="colTipo" text="Tipo"/>
                        <TableColumn fx:id="colCategoria" text="Categoría"/>
                        <TableColumn fx:id="colMonto" text="Monto"/>
                        <TableColumn fx:id="colDescripcion" text="Descripción"/>
                    </columns>
                </TableView>
            </children>
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
        </VBox>
    </children>
</AnchorPane>