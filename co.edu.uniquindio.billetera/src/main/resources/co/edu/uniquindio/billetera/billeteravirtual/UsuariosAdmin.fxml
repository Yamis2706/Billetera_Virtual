<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="co.edu.uniquindio.billetera.billeteravirtual.controller.UsuarioAdminController" prefWidth="800" prefHeight="600">
    <children>
        <VBox spacing="15" alignment="TOP_CENTER" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
            <children>
                <Label text="Gestión de Usuarios" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="100"/>
                        <ColumnConstraints minWidth="200"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="30"/>
                        <RowConstraints minHeight="30"/>
                        <RowConstraints minHeight="30"/>
                        <RowConstraints minHeight="30"/>
                        <RowConstraints minHeight="30"/>
                    </rowConstraints>
                    <children>
                        <Label text="ID (4 dígitos):" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtCedula" promptText="Ej: 1234" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Nombre:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtNombre" promptText="Nombre completo" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Correo:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtCorreo" promptText="correo@ejemplo.com" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Teléfono:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="txtTelefono" promptText="Teléfono" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                        <Label text="Tipo:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <ComboBox fx:id="cbTipo" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    </children>
                </GridPane>
                <HBox spacing="10" alignment="CENTER">
                    <Button text="Crear" onAction="#crearUsuario"/>
                    <Button text="Actualizar" onAction="#actualizarUsuario"/>
                    <Button text="Eliminar" onAction="#eliminarUsuario"/>
                </HBox>
                <Label fx:id="lblMensaje" style="-fx-text-fill: red;"/>
                <TableView fx:id="tablaUsuarios" prefHeight="350">
                    <columns>
                        <TableColumn fx:id="colId" text="ID"/>
                        <TableColumn fx:id="colNombre" text="Nombre"/>
                        <TableColumn fx:id="colCorreo" text="Correo"/>
                        <TableColumn fx:id="colTelefono" text="Teléfono"/>
                        <TableColumn fx:id="colTipo" text="Tipo"/>
                    </columns>
                </TableView>
            </children>
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
        </VBox>
    </children>
</AnchorPane>