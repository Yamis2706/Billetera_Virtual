<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="10" xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.uniquindio.billetera.billeteravirtual.controller.UsuarioAdminController">
    <Label text="Gestión de Usuarios" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <TableView fx:id="tablaUsuarios" prefHeight="250">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
            <TableColumn fx:id="colCorreo" text="Correo" prefWidth="180"/>
            <TableColumn fx:id="colTipo" text="Tipo" prefWidth="80"/>
        </columns>
    </TableView>
    <HBox spacing="10">
        <TextField fx:id="txtNombre" promptText="Nombre"/>
        <TextField fx:id="txtCorreo" promptText="Correo"/>
        <ComboBox fx:id="cbTipo" promptText="Tipo" prefWidth="100"/>
    </HBox>
    <HBox spacing="10">
        <Button text="Crear" onAction="#crearUsuario"/>
        <Button text="Actualizar" onAction="#actualizarUsuario"/>
        <Button text="Eliminar" onAction="#eliminarUsuario"/>
    </HBox>
    <Label fx:id="lblMensaje" textFill="red"/>
</VBox>