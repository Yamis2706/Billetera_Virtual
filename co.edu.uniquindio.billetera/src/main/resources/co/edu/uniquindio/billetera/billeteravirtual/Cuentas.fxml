<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="800.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.billetera.billeteravirtual.controller.CuentaController">
    <children>
        <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10">
            <children>
                <Label text="Gestión de Cuentas" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                <TableView fx:id="tablaCuentas" prefHeight="300.0" prefWidth="800.0">
                    <columns>
                        <TableColumn fx:id="colIdCuenta" prefWidth="100.0" text="ID Cuenta" />
                        <TableColumn fx:id="colBanco" prefWidth="100.0" text="Banco" />
                        <TableColumn fx:id="colNumero" prefWidth="100.0" text="Número" />
                        <TableColumn fx:id="colTipo" prefWidth="100.0" text="Tipo" />
                        <TableColumn fx:id="colSaldo" prefWidth="100.0" text="Saldo" />
                        <TableColumn fx:id="colIdUsuario" prefWidth="100.0" text="ID Usuario" />
                        <TableColumn fx:id="colIdPresupuesto" prefWidth="120.0" text="ID Presupuesto" />
                    </columns>
                </TableView>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Banco:"/>
                        <TextField fx:id="txtBanco" promptText="Nombre del banco" prefWidth="120"/>
                        <Label text="Número:"/>
                        <TextField fx:id="txtNumero" promptText="Número de cuenta" prefWidth="120" editable="true"/>
                        <Label text="Tipo:"/>
                        <TextField fx:id="txtTipo" promptText="Ahorro/Corriente" prefWidth="100"/>
                        <Label text="Saldo inicial:"/>
                        <TextField fx:id="txtSaldoInicial" promptText="Saldo inicial" prefWidth="100"/>
                        <Label text="ID Usuario:"/>
                        <TextField fx:id="txtIdUsuario" promptText="ID del usuario" prefWidth="100"/>
                        <Label text="Presupuesto:"/>
                        <ComboBox fx:id="cbPresupuesto" promptText="ID Presupuesto" prefWidth="120"/>
                    </children>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <Button fx:id="btnCrear" text="Crear Cuenta" onAction="#crearCuenta" prefWidth="120"/>
                        <Button fx:id="btnModificar" text="Modificar Cuenta" onAction="#modificarCuenta" prefWidth="120"/>
                        <Button fx:id="btnEliminar" text="Eliminar Cuenta" onAction="#eliminarCuenta" prefWidth="120"/>
                    </children>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <children>
                        <Label text="Consultar por ID o Número:"/>
                        <TextField fx:id="txtConsulta" promptText="ID o Número" prefWidth="150"/>
                        <Button fx:id="btnConsultar" text="Consultar" onAction="#consultarCuenta" prefWidth="100"/>
                    </children>
                </HBox>
                <Label text="Movimientos:"/>
                <TextArea fx:id="txtMovimientos" editable="false" prefHeight="130" prefWidth="800"/>
                <Label fx:id="lblMensaje" textFill="red"/>
            </children>
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
        </VBox>
    </children>
</AnchorPane>