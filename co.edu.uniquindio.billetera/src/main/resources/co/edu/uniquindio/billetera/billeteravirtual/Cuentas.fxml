<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="400.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.billetera.billeteravirtual.controller.CuentaController">
    <children>
        <TableView fx:id="tablaCuentas" layoutX="20.0" layoutY="20.0" prefHeight="250.0" prefWidth="760.0">
            <columns>
                <TableColumn fx:id="colNumero" prefWidth="150.0" text="Número" />
                <TableColumn fx:id="colBanco" prefWidth="150.0" text="Banco" />
                <TableColumn fx:id="colTipo" prefWidth="150.0" text="Tipo" />
                <TableColumn fx:id="colSaldo" prefWidth="150.0" text="Saldo" />
            </columns>
        </TableView>
        <HBox layoutX="20.0" layoutY="290.0" spacing="20.0">
            <children>
                <Button fx:id="btnDepositar" text="Depositar Dinero"
                        onAction="#agregarDinero" prefWidth="150.0"/>
                <Button fx:id="btnRetirar" text="Retirar Dinero" onAction="#retirarDinero" prefWidth="150.0"/>
                <Button fx:id="btnTransferir" text="Transferir Dinero" onAction="#transferirDinero" prefWidth="150.0"/>
            </children>
            <padding>
                <Insets left="0.0" top="10.0" right="0.0" bottom="0.0"/>
            </padding>
        </HBox>
        <Label fx:id="lblMensaje" layoutX="20.0" layoutY="350.0" textFill="red"/>
    </children>
</AnchorPane>